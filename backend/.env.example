# Database Connection String (Direct or Pooler)
# Supabase Direct: postgresql://[USER]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Supabase Pooler: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/chicken_shop_db

# Supabase Project Credentials
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_URL=https://your_supabase_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

JWT_SECRET=your_jwt_super_secret_key_here
JWT_EXPIRES_IN=7d
SHOP_NAME=Reddy Chicken and Mutton Center
SHOP_ADDRESS=old alwal secenderabad
SHOP_PHONE=7989856610
CURRENCY_SYMBOL=₹
DATE_FORMAT=DD-MM-YYYY
TIMEZONE=Asia/Kolkata
NODE_ENV=development
